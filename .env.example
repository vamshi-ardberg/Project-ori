# Required: Neon PostgreSQL pooled connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_POOLED=postgresql://user:password@pooler-host/database?sslmode=require

# Optional stable key for the shared workspace. Use a former account email to retain its existing data.
SENTINEL_WORKSPACE_ID=default
SENTINEL_WORKSPACE_NAME=Sentinel workspace

# OpenAI Decisions API — GPT-6 Luna (server-side only)
OPENAI_API_KEY=
DECISION_MIN_CONFIDENCE=0.65

# GitHub pull-request signals. GITHUB_REPO must be owner/repository.
GITHUB_TOKEN=
GITHUB_REPO=

# Google Drive read-only shared-folder connector (service account JSON on one line)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# Jira Cloud issue signals
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=statusCategory != Done ORDER BY priority DESC

# Optional generic HRIS/supplier/Slack/internal ingestion endpoint
SENTINEL_INGEST_TOKEN=replace-with-a-long-random-secret
